# 仅用于本地开发。复制为 .env 后修改默认值，禁止提交真实密钥。
POSTGRES_DB=teammind
POSTGRES_USER=teammind
POSTGRES_PASSWORD=teammind_local_password
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# 下列变量由 Java 进程读取，不会自动从 .env 注入；请通过 export 或 IDE 环境变量设置。
# QWEN_API_KEY=替换为你的密钥
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_CHAT_MODEL=qwen-plus
EMBEDDING_DIMENSION=1024
QWEN_CONNECT_TIMEOUT=5s
QWEN_READ_TIMEOUT=60s

# 文档处理与知识库向量检索参数。
DOCUMENT_STORAGE_PATH=./data/documents
DOCUMENT_MAX_FILE_BYTES=20971520
DOCUMENT_CHUNK_TOKENS=640
DOCUMENT_OVERLAP_TOKENS=100
DOCUMENT_EMBEDDING_BATCH_SIZE=10
DOCUMENT_MAX_CHUNKS=2000
QDRANT_COLLECTION=team_mind_chunks
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.25

# 本地 Ollama 模式使用 local,ollama 双 profile，无需设置云端 QWEN_API_KEY。
# 如需覆盖默认值，可在启动 Java 前导出以下变量。
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_QDRANT_COLLECTION=team_mind_chunks_local_qwen3_1024
OLLAMA_READ_TIMEOUT=180s
